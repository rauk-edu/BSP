rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health check test connection
    match /test/{docId} {
      allow read: if true;
    }

    // BSP Strategic Plans Collection
    match /bsp_plans/{planId} {
      allow list: if true;
      allow get: if isValidId(planId);
      allow create: if isValidId(planId);
      allow update: if isValidId(planId);
      allow delete: if isValidId(planId);
    }
  }
}
